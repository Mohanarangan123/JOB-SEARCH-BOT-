# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=job_discovery

# Search & Fetch
MAX_SEARCH_RESULTS=100
MAX_FETCHES_PER_RUN=50
REQUEST_TIMEOUT=30
RETRY_COUNT=3
BACKOFF_BASE=2.0
CIRCUIT_BREAKER_THRESHOLD=5
QUERY_COOLDOWN=60

# LLM
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_CACHE_TTL=86400

# Storage
RAW_RETENTION_DAYS=30
EXPORT_OUTPUT_PATH=./exports

# Lifecycle
JOB_REMOVED_AFTER_CONSECUTIVE_FAILURES=3

# Ranking weights (JSON object)
RANKING_WEIGHTS={"recency": 0.4, "completeness": 0.3, "source_reliability": 0.3}
